{
  "cleanUrls": true,
  "functions": {
    "api/content.js": {
      "includeFiles": "content/**"
    }
  },
  "rewrites": [
    { "source": "/tree", "destination": "/" },
    { "source": "/tree/:path*", "destination": "/" },
    { "source": "/notebooks/:path*", "destination": "/" },
    { "source": "/edit/:path*", "destination": "/" }
  ]
}
